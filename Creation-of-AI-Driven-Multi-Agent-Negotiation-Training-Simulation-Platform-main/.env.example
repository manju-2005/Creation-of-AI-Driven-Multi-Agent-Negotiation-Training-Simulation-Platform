# Environment Configuration for AI Multi-Agent Negotiation Simulator

PROJECT_NAME="AI Multi-Agent Negotiation Simulator"
API_V1_STR="/api"

MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="negotiation_db"

# LLM Provider Configuration
GEMINI_API_KEY="Azcd..."

DEFAULT_MODEL="gemini-3.5-flash-lite"

# Optional: minimum seconds between Gemini calls (client-side throttle)
GEMINI_MIN_INTERVAL_SECONDS=15

# Secondary/fallback LLM (Groq - free tier). Get a free key at https://console.groq.com/keys
# When set, the app automatically switches to Groq if Gemini is rate-limited/exhausted,
# so negotiations keep running without interruption.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

MAX_ROUND_LIMIT=15
MAX_VALIDATION_ATTEMPTS=2
DEADLOCK_THRESHOLD=0.01
DEADLOCK_ROUNDS=3
MAX_CONTEXT_WINDOW=4096